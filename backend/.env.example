# MediKiosk configuration. Do not commit real credentials or secrets.
# For local prototype use: SIH_ENV=demo
SIH_ENV=demo
SIH_DEMO_MODE=1

# Database. Default is backend/sih26047.db
# SIH_DATABASE_URL=sqlite:///./sih26047.db

# Keep uploads outside the source tree in production.
# SIH_UPLOAD_DIR=/var/lib/medikiosk/uploads

# Explicit browser origins, comma-separated. Never use * with credentials.
SIH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo-only credentials. Change them before sharing the prototype.
SIH_DEMO_PATIENT_EMAIL=patient@sih26047.local
SIH_DEMO_PATIENT_PASSWORD=change-me-patient
SIH_DEMO_DOCTOR_EMAIL=doctor@sih26047.local
SIH_DEMO_DOCTOR_PASSWORD=change-me-doctor
SIH_DEMO_ADMIN_EMAIL=admin@sih26047.local
SIH_DEMO_ADMIN_PASSWORD=change-me-admin

# Session/password controls
SIH_SESSION_MINUTES=120
SIH_SESSION_IDLE_MINUTES=60
SIH_LOGIN_WINDOW_SECONDS=60
SIH_LOGIN_MAX_FAILURES=10
SIH_PASSWORD_KDF_ITERATIONS=210000

# HTTP / deployment hardening
# Production requires explicit trusted hosts and HTTPS.
SIH_TRUSTED_HOSTS=localhost,127.0.0.1
SIH_REQUIRE_HTTPS=0
SIH_MAX_REQUEST_BODY_MB=32
